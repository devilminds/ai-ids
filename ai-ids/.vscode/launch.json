{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AI-IDS: FastAPI (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "AI-IDS: Train ML model",
      "type": "debugpy",
      "request": "launch",
      "module": "app.ml.train",
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal"
    }
  ]
}
