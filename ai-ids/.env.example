# Copy to .env and edit as needed. All of these have safe local defaults,
# so the project runs without a .env file at all for local/dev use.

# Leave unset to use local SQLite (./backend/ai_ids.db).
# For Postgres / docker-compose:
# DATABASE_URL=postgresql://ai_ids_admin:ChangeMe123!@localhost:5432/ai_ids_db

JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

CORS_ORIGINS=*

POSTGRES_PASSWORD=ChangeMe123!
